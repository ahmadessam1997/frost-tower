<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- AdMob application ID. REQUIRED: the Google Mobile Ads SDK throws
             at startup if this is missing, so the app would crash on launch.
             Keep it identical to admob.appId in www/js/config.js.
             Real AdMob app id, set 2026-08-08. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7898882561225435~4844848706"
        />

        <!-- Play Games services project ID. Same failure mode as the AdMob id
             above: the PGS SDK throws at startup if this is absent, so the
             value lives in strings.xml and is referenced, never inlined. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed by the ads SDK to read the advertising ID on API 33+.
         This permission is exactly why the Play data-safety form can no
         longer say "no data collected" — see privacy-policy.md. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
